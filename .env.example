# Copy to .env and fill in. Never commit .env. Marcus refuses to start if a required value is missing.

# Required (ECHELON_API_KEY is optional)
POSTGRES_PASSWORD=
# At least 16 characters. The frontend proxy sends it as X-API-Key.
API_KEY=
OMNIROUTE_API_KEY=
# Optional. Leave ECHELON_API_KEY empty to run Marcus without ECHELON.
ECHELON_API_KEY=
# Your approval PIN, 8+ characters. Required whenever the stack is started with docker compose (compose refuses to start without it, even with ECHELON off), and whenever ECHELON_API_KEY is set.
# The app asks for it on every approval, on resume and when answering a blocked task. Five wrong tries lock approvals for 15 minutes. Keep it to yourself: it is never logged or sent to ECHELON.
APPROVAL_PIN=

# Optional
OMNIROUTE_MODEL=gpt-4o-mini
# Optional faster model for voice turns. Empty uses OMNIROUTE_MODEL.
OMNIROUTE_VOICE_MODEL=
ECHELON_BASE_URL=http://host.docker.internal:3000
# Price estimates in USD per 1M tokens, used for the spend cap when OmniRoute reports no cost
# OMNIROUTE_PRICE_IN_PER_1M=0.15
# OMNIROUTE_PRICE_OUT_PER_1M=0.60
# OMNIROUTE_EMBED_PRICE_PER_1M=0.02
# MARCUS_SPEND_CAP_USD=20
# MARCUS_SPEND_WARNING_PCT=70
# DEFAULT_TIMEZONE=America/Edmonton
